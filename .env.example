# Copy this file to .env.local and fill in ONE provider.
# With no key set, the built-in rule coach answers and the app still works.
# .env.local is git-ignored, so keys never reach the repository.

# Which provider to use: openai | anthropic | gemini.
# Leave empty to auto-pick the first provider below that has a key.
COACH_PROVIDER=

# API keys — set only the provider you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY or GOOGLE_API_KEY both work for Google.
GEMINI_API_KEY=

# Optional: override the model for the chosen provider.
#   openai    default gpt-4o-mini
#   anthropic default claude-haiku-4-5
#   gemini    default gemini-2.5-flash
COACH_MODEL=

# Optional: how long to wait for a provider before falling back, in milliseconds.
COACH_TIMEOUT_MS=15000

# Optional: shared secret for POST /api/coach. When set, clients must send
# "Authorization: Bearer <token>" (or x-coach-token). Leave empty for the demo.
COACH_API_TOKEN=

# Optional account-backed Settings storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use this key name instead:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key for Ranked. Never expose this publicly.
SUPABASE_SECRET_KEY=
